# このファイルをコピーして .env を作成する: cp .env.example .env

# PostgreSQL接続文字列。Vercel Postgresを使う場合はVercelダッシュボードが自動で注入するため、
# 本番では手動設定不要。ローカル開発では同じPostgres URLをここに貼る。
DATABASE_URL=""

# セッションCookie署名用のランダムな秘密鍵。`openssl rand -hex 32` などで生成する。
SESSION_SECRET=""

# --- 本番化に必要（現状未設定・モックで動作） ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_JAPAN=
# STRIPE_PRICE_ID_GLOBAL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# モック決済・モックOAuthを有効にするフラグ（本番では false にして上記キーを設定する）
MOCK_BILLING="true"
